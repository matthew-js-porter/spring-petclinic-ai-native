<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
		"-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
		"https://checkstyle.org/dtds/configuration_1_3.dtd">
<!-- Spring's ruleset as shipped in spring-javaformat-checkstyle, unchanged except for the header check. -->
<module name="com.puppycrawl.tools.checkstyle.Checker">
	<module name="io.spring.javaformat.checkstyle.SpringChecks">
		<!-- The sources carry no licence header and adding one to every file is out of scope. -->
		<property name="headerType" value="none" />
	</module>
</module>
