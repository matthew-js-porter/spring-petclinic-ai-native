package org.example.clinic;

import java.util.Random;

import org.junit.jupiter.api.Test;

import static org.assertj.core.api.Assertions.assertThat;

class VisitSchedulerTests {

	private final Random random = new Random(42);

	@Test
	public void flagsEmergency() {
		assertThat(new VisitScheduler().isEmergency("emergency")).isTrue();
	}

	@Test
	void referencesAreHex() {
		assertThat(new VisitScheduler().bookingReference()).matches("[0-9a-f]+");
		assertThat(this.random.nextInt(10)).isLessThan(10);
	}

}
