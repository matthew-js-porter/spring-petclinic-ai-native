{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "SnykCode",
          "rules": [
            {
              "id": "SNYK-EVAL-CODE-2001",
              "shortDescription": {
                "text": "SQL Injection"
              },
              "help": {
                "text": "Unsanitized input flows into a SQL query. Use a parameterized query.",
                "markdown": "Unsanitized input flows into a SQL query. Use a parameterized query."
              },
              "properties": {
                "tags": [
                  "security",
                  "high"
                ],
                "security-severity": "8.6"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "SNYK-EVAL-CODE-2001",
          "level": "error",
          "message": {
            "text": "High severity: unsanitized input from the lastName parameter flows into queryForList, where it is used in an SQL query."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/main/java/org/example/clinic/OwnerSearch.java"
                },
                "region": {
                  "startLine": 20
                }
              }
            }
          ]
        }
      ]
    }
  ]
}